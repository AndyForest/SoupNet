# Root env vars shared across services.
# Copy to .env and fill in values. Never commit .env files.

# ── Postgres ────────────────────────────────────────────────────────────────
# Individual PG* vars — matches what ECS uses in production (PGPASSWORD comes
# from the auto-rotating RDS master user secret). Locally all vars are in .env.
# SoupNet's local stack uses port 5633 so it can coexist with claimNet on 5533.
PGHOST=localhost
PGPORT=5633
PGUSER=claimnet
PGPASSWORD=claimnet
PGDATABASE=claimnet

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Use: openssl rand -hex 32 to generate:
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# ── Signup bot check (optional) ──────────────────────────────────────────────
# Cloudflare Turnstile on the signup form. Off when unset. Needs both: the
# site key in the SPA build and the secret on the backend. Cloudflare's test
# keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# always pass; site 2x00000000000000000000AB always blocks.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Dev auto-setup ───────────────────────────────────────────────────────────
# If set and no users exist, a system user is auto-created on startup.
DEV_USERNAME=admin@soup.net
DEV_PASSWORD=changeme123

# ── Test auto-setup ──────────────────────────────────────────────────────────
# If set, integration tests use this account instead of creating throwaway users.
# Also auto-created on startup alongside the dev user (dev environment only).
TEST_USERNAME=test@test.local
TEST_PASSWORD=test-password-123

# ── Email ────────────────────────────────────────────────────────────────────
# Local dev: Mailpit (docker-compose sets these automatically)
# Production: AWS SES (SMTP endpoint from SES console)
SMTP_HOST=localhost
SMTP_PORT=1125
EMAIL_FROM=noreply@soup.net

# SES bounce/complaint pipeline: name of the SES configuration set to stamp on
# outgoing mail (X-SES-CONFIGURATION-SET header). Production-only; leave unset
# locally — Mailpit and non-SES SMTP servers ignore the header.
# SES_CONFIGURATION_SET=

# ── OAuth (MCP connectors) ───────────────────────────────────────────────────
# BACKEND_URL (below) is the OAuth issuer and the protected resource that
# access tokens are bound to; keep it the public origin clients connect to.
# OpenAI plugin portal domain token, served as plain text at
# /.well-known/openai-apps-challenge; unset serves 404.
# OPENAI_APPS_CHALLENGE_TOKEN=
# Clients identified by a metadata-document URL (CIMD): real fetches per
# client IP per hour (default 30), and extra hosts a document may not live on
# beyond this server's own origins and their parent domain (comma-separated).
# OAUTH_CIMD_FETCHES_PER_IP_HOURLY=30
# OAUTH_CIMD_DENIED_HOSTS=

# ── Embedding ─────────────────────────────────────────────────────────────────
# Required for vector search. Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embedding provider for the worker pipeline:
#   gemini             — real Gemini API (default; required in production)
#   stub               — deterministic fake 3072-dim vectors. No API calls, no
#                        quota. Recommended for local dev so integration tests
#                        don't burn quota. The cache code path is still fully
#                        exercised — only the leaf API call is replaced. One
#                        opt-in test (gemini-embeddings.test.ts) always uses real
#                        Gemini when GEMINI_API_KEY is set.
#   local              — in-process CPU model via @huggingface/transformers
#                        (ONNX). No external service, no API key. Vectors are
#                        zero-padded into the existing halfvec(3072) column
#                        (lossless for cosine). Great for tire-kickers, CI smoke
#                        tests, and no-external-API self-hosters.
#   openai-compatible  — any OpenAI-style /v1/embeddings endpoint (llama.cpp,
#                        LM Studio, Ollama, TEI, vLLM). Set EMBEDDINGS_BASE_URL +
#                        EMBEDDINGS_MODEL below.
# Search reads one model at a time — vectors from different models occupy
# different semantic spaces and are never mixed. To change model with search
# working throughout, use EMBEDDINGS_REBUILD_TARGET below. See
# docs/adr/0024-embedding-model-switch.md.
EMBEDDINGS_PROVIDER=stub

# Model id: the model search reads and the check path writes. Meaning depends on
# the provider:
#   gemini             — Optional. Unset, each process reads the model the database's
#                        vectors are under, and a database with no vectors starts on
#                        gemini-embedding-2. With vectors under two models and no
#                        rebuild target it refuses to start rather than guess. Set,
#                        it must be gemini-embedding-2 or gemini-embedding-2-preview,
#                        or the backend refuses to start. A different model from the
#                        vectors makes search return nothing until the worker has
#                        re-embedded the corpus.
#   local              — the FULL Hugging Face repo id transformers.js loads (org
#                        included), NOT a bare name. Default (when empty):
#                        Xenova/bge-small-en-v1.5 (384-dim, ~23 MB, no
#                        query/passage prefix needed). Xenova/all-MiniLM-L6-v2 is
#                        the most-proven fallback (also 384-dim). The Docker image
#                        bakes the default model for offline use; to run a
#                        different model either rebuild with
#                        --build-arg HF_MODEL=<repo id> or mount an HF_HOME volume
#                        and unset HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE.
#   openai-compatible  — the model id the endpoint reports/serves.
# local: leave empty for the default. Ignored by stub.
EMBEDDINGS_MODEL=

# Rebuild target: a second model the worker keeps a full set of vectors for, while
# search keeps reading EMBEDDINGS_MODEL. Set it, watch the "[embedding-rebuild]" log
# line until safe_to_flip=yes, then set both values, swapped, to flip reads. gemini
# and openai-compatible only; empty means no rebuild. The steps are in ADR-0024.
EMBEDDINGS_REBUILD_TARGET=
# How many vectors the rebuild may add per minute across all tasks. 0 pauses it.
# Default 600. At about 49,000 vectors that's about 80 minutes.
EMBEDDINGS_REBUILD_VECTORS_PER_MINUTE=

# openai-compatible only: base URL of the /v1/embeddings endpoint, and an
# optional bearer key (leave empty when the harness needs no auth). The model's
# native dimension must be <= 3072 (or MRL-capable) so it fits the halfvec(3072)
# column. Example base URLs:
#   llama.cpp (llama-server --embedding --pooling mean --port 8080)  http://localhost:8080/v1
#   LM Studio (Developer -> Start Server)                            http://localhost:1234/v1
#   Ollama    (ollama pull nomic-embed-text) — alternative           http://localhost:11434/v1
# When Soup.net runs in its own container, localhost above means the container —
# use host.docker.internal (Docker Desktop) or the host IP for a harness on the host.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# ── Synthesis ─────────────────────────────────────────────────────────────────
# The premium `synthesize` feature (retrieval synthesis) makes one server-side
# LLM call to distil a check's exemplars into a "current preference profile".
# Reuses the same GEMINI_API_KEY as embeddings above.
#
# Provider:
#   gemini  — real Gemini generateContent (default; required for real synthesis)
#   stub    — deterministic profile, no LLM call. Recommended for local dev/tests
#             so the path is exercised without burning quota (mirrors EMBEDDINGS).
SYNTHESIS_PROVIDER=stub
# Model used when SYNTHESIS_PROVIDER=gemini. Swap the model by changing this env.
SYNTHESIS_MODEL=gemini-3.5-flash

# ── App URLs ─────────────────────────────────────────────────────────────────
# Backend listening port for non-docker dev (`npm run dev:backend`).
# Docker overrides this to 3001 internally and maps host:3101 → container:3001.
PORT=3101
BACKEND_URL=http://localhost:3101

# Frontend dev server port (Vite reads FRONTEND_PORT from this file via vite.config.ts).
FRONTEND_PORT=5273
FRONTEND_URL=http://localhost:5273

# Frontend's URL for the backend, exposed to client code via import.meta.env.VITE_API_BASE.
# Vite picks up VITE_*-prefixed vars from this file at dev-server start (envDir = repo root).
# CI overrides at production build time (e.g., https://mcp.soup.net).
VITE_API_BASE=http://localhost:3101

MCP_PORT=3102

# ── Sign in with Google (optional) ───────────────────────────────────────────
# A Google Cloud OAuth client (Web application) with the authorized redirect
# URI ${BACKEND_URL}/auth/google/callback, e.g. http://localhost:3101/auth/google/callback,
# and the consent screen's scopes openid, email and profile only (no Google
# review needed). Leave the id empty to turn Google sign-in off: the button
# disappears and /auth/google/* answers 404. See docs/adr/0022-oauth-connector-and-google-sign-in.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Workspace directory offboarding (optional) ───────────────────────────────
# 32 bytes (64 hex characters or base64; e.g. `openssl rand -hex 32`) that
# encrypt a company's Google Workspace directory credential. Needs Google
# sign-in above. Empty turns the directory check off. Rotating it isn't
# supported yet (backlog). Customer setup: docs/operations/google-workspace-directory.md.
DIRECTORY_CREDENTIALS_KEY=

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ── Rate limits (agent surfaces) ─────────────────────────────────────────────
# All optional — the defaults below ship in code (raised 2026-08-19 for
# concurrent sub-agent fleets sharing one key and one IP; see
# docs/planning/recipe-search-design.md and the F29 comments in
# apps/backend/src/middleware/rate-limit.ts). Override to tune a hosted
# deployment without a code change.
#PER_KEY_RATE_LIMIT_HOURLY=600     # F29: recipe checks per key per hour
#PER_KEY_RATE_LIMIT_DAILY=4000     # F29: recipe checks per key per day
#CHECK_IP_RATE_LIMIT_HOURLY=3000   # /check requests per IP per hour
#MCP_IP_RATE_LIMIT_HOURLY=3000     # /mcp requests per IP per hour
#MCP_BEARER_RATE_LIMIT_HOURLY=1200 # all MCP methods per key per hour (F43 backstop)
#SEARCH_ONLY_RATE_LIMIT_HOURLY=600 # web read-only searches per key per hour

# ── Local embedding cache archive (optional) ─────────────────────────────────
# A long-lived copy of vector_cache that outlives dev/test databases. See
# docs/workflows/embedding-cache.md. The defaults match
# docker-compose.embedding-cache.yml; set these only to change them.
# EMBEDDING_CACHE_URL=postgresql://cache_writer:cache_writer@127.0.0.1:5733/embedding_cache
# EMBEDDING_CACHE_ADMIN_URL=postgresql://cache_admin:cache_admin@127.0.0.1:5733/embedding_cache
# EMBEDDING_CACHE_BACKUP_DIR=
# EMBEDDING_CACHE_SOURCES=postgresql://claimnet:claimnet@localhost:5633/claimnet
